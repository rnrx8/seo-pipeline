# Set these only on the backend (Railway); never use NEXT_PUBLIC_ variables.
SERP_PROVIDER=serper
SERPER_API_KEY=
# Existing SerpAPI can be selected explicitly for diagnosis. A consistency
# failure stops the job instead of using a different search mode as rankings.
# SERP_PROVIDER=serpapi
# SERPAPI_KEY=

# Require a fresh browser snapshot; never fall back to a provider.
# SERP_PROVIDER=browser
